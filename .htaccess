# Ramki Cards - Apache configuration (download template; deploy as .htaccess)

DirectoryIndex index.php index.html
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect the live website to HTTPS. Localhost is excluded for XAMPP/WAMP.
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

    # Remove index.php from any browser URL while preserving the full web path.
    # Examples:
    #   /index.php                    -> /
    #   /git/ramkicard/index.php      -> /git/ramkicard/
    #   /git/ramkicard/admin/index.php -> /git/ramkicard/admin/
    #
    # The redirect target is captured from THE_REQUEST instead of using "./".
    # This prevents WAMP from exposing C:/wamp64/www/... as a browser URL.
    # Permanent redirect on the live domain.
    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.php(?:[?\s]|$) [NC]
    RewriteRule ^(?:.*/)?index\.php$ /%1 [R=301,L,NE]

    # Temporary redirect on localhost to avoid caching mistakes during development.
    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
    RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.php(?:[?\s]|$) [NC]
    RewriteRule ^(?:.*/)?index\.php$ /%1 [R=302,L,NE]

    # Remove .php from every directly requested PHP page, including nested pages.
    # Examples:
    #   /services.php                         -> /services
    #   /git/ramkicard/services.php           -> /git/ramkicard/services
    #   /git/ramkicard/admin/enquiries.php    -> /git/ramkicard/admin/enquiries
    # Query strings such as product.php?slug=... are preserved automatically.
    # POST requests are excluded so forms, APIs and enquiry submissions keep working.
    # Permanent clean-page redirect on the live domain.
    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php(?:[?\s]|$) [NC]
    RewriteRule ^(.+?)\.php$ /%1 [R=301,L,NE]

    # Temporary clean-page redirect on localhost.
    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
    RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php(?:[?\s]|$) [NC]
    RewriteRule ^(.+?)\.php$ /%1 [R=302,L,NE]

    # Internally load the matching PHP file for every clean public/admin URL.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [QSA,L]
</IfModule>

# Block direct access to configuration, backup and database files.
<FilesMatch "(^\.env|^\.git|composer\.(json|lock)|package(-lock)?\.json|.*\.(sql|log|ini|bak|old|dist))$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 7 days"

    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType application/json "access plus 0 seconds"

    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/avif "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"

    ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|jpg|jpeg|png|gif|webp|avif|svg|woff2)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    <FilesMatch "\.(php|html)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>
